<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Prompt 6, req 2-3: responds to the watch's /request-workout
             message (manual download or the scheduled WorkManager job — same
             path). Manifest-registered so it works even when the phone app
             isn't foregrounded. -->
        <service
            android:name=".weardata.WorkoutRequestListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/request-workout" />
            </intent-filter>
        </service>

        <!-- Prompt 8, req 3-4: watch -> phone log sync on Complete Set/Skip.
             Manifest-registered so it works even when the phone app isn't
             foregrounded. -->
        <service
            android:name=".weardata.LogListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/log" />
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- POST_NOTIFICATIONS: declared here explicitly (also pulled in by
         @capacitor/local-notifications' own manifest); requested at RUNTIME
         on first launch from MainActivity — see Prompt 3 req 4. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Prompt 3 req 3: inexact alarms only, no exact-alarm permission screen.
         No dependency currently declares these, but block them defensively
         so a future plugin/library bump can't silently reintroduce them. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />
</manifest>
